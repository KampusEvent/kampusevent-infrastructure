global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: auth-service
    scheme: https
    metrics_path: /auth/metrics
    static_configs:
      - targets: ["${GATEWAY_HOST}"]

  - job_name: event-service
    scheme: https
    metrics_path: /events/metrics
    static_configs:
      - targets: ["${GATEWAY_HOST}"]

  - job_name: registration-service
    scheme: https
    metrics_path: /registrations/metrics
    static_configs:
      - targets: ["${GATEWAY_HOST}"]

  - job_name: attendance-service
    scheme: https
    metrics_path: /attendance/metrics
    static_configs:
      - targets: ["${GATEWAY_HOST}"]
