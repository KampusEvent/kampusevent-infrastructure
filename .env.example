# Shared secrets and service URLs
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
INTERNAL_API_KEY=change-me-internal-key
JWT_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
SEED_USERS=true

# Service URLs (internal Docker network — not exposed to host)
AUTH_SERVICE_URL=http://auth-service:8001
EVENT_SERVICE_URL=http://event-service:8002
REGISTRATION_SERVICE_URL=http://registration-service:8003
ATTENDANCE_SERVICE_URL=http://attendance-service:8004

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# E2E test URLs (via API Gateway — sole external entry point)
E2E_GATEWAY_URL=http://localhost:8080
E2E_AUTH_URL=http://localhost:8080/auth
E2E_EVENT_URL=http://localhost:8080
E2E_REGISTRATION_URL=http://localhost:8080
E2E_ATTENDANCE_URL=http://localhost:8080
E2E_PROMETHEUS_URL=http://localhost:9090
