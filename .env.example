# Shared secrets and service URLs
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
SEED_USERS=true

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:8001
EVENT_SERVICE_URL=http://event-service:8002
REGISTRATION_SERVICE_URL=http://registration-service:8003
ATTENDANCE_SERVICE_URL=http://attendance-service:8004

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# E2E test URLs (host machine)
E2E_AUTH_URL=http://localhost:8001
E2E_EVENT_URL=http://localhost:8002
E2E_REGISTRATION_URL=http://localhost:8003
E2E_ATTENDANCE_URL=http://localhost:8004
